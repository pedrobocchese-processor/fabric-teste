	partition F_Projeto_Dedicado_Car_House = calculated
		mode: import
		source = ```
				
				VAR DiasUteis =
				    FILTER(
				        ADDCOLUMNS(
				            CALENDAR( DATE(2025,1,1), DATE(2025,12,31) ),
				            "DiaSemana", WEEKDAY( [Date], 2 )
				        ),
				        [DiaSemana] <= 5
				    )
				
				VAR DiasIndexados =
				    ADDCOLUMNS(
				        ADDCOLUMNS( DiasUteis, "Ano", YEAR( [Date] ), "Mes", MONTH( [Date] ) ),
				        "IdxDiaMes",
				            VAR _Ano = YEAR( [Date] )
				            VAR _Mes = MONTH( [Date] )
				            VAR _ThisDate = [Date]
				            RETURN
				                COUNTROWS(
				                    FILTER(
				                        DiasUteis,
				                        YEAR( [Date] ) = _Ano
				                            && MONTH( [Date] ) = _Mes
				                            && [Date] <= _ThisDate
				                    )
				                )
				    )
				
				VAR DiasLimitados =
				    FILTER( DiasIndexados, [IdxDiaMes] <= 20 )
				
				VAR LinhasComTurnos =
				    ADDCOLUMNS(
				        GENERATE(
				            DiasLimitados,
				            DATATABLE( "Turno", STRING, { { "Manhã" }, { "Tarde" } } )
				        ),
				        "Codigo", 35000 + ( [IdxDiaMes] - 1 ) * 2 + IF( [Turno] = "Tarde", 1, 0 ),
				        "CodigoContrato", 7399,
				        "DescricaoContrato", "7399 - Contrato de Consultoria",
				        "CodigoGrupo", 5396,
				        "CodigoAtividade", BLANK(),
				        "CodigoProfissional", 1080,
				        "Funcao", "Arquiteto - Sr",
				        "Inicio",
				            IF(
				                [Turno] = "Manhã",
				                [Date] + TIME(8,0,0),
				                [Date] + TIME(13,0,0)
				            ),
				        "Fim",
				            IF(
				                [Turno] = "Manhã",
				                [Date] + TIME(12,0,0),
				                [Date] + TIME(17,0,0)
				            ),
				        "Tempo", TIME(4,0,0),
				        "Horas", 4,
				        "DescricaoGrupo", "Projeto Dedicado",
				        "DescricaoAtividade", "Atendimento Projeto Dedicado",
				        "NomeProfissional", "Cesar Ricardo Balan",
				        "Email", "cesar.balan@processor.com.br",
				        "Observacao", "Atendimento projeto dedicado CarHouse",
				        "DataInc", [Date] + TIME(8,0,0),
				        "Cliente", "Car House",
				        "Grupo", "Car House Veiculos"
				    )
				
				RETURN
				    SELECTCOLUMNS(
				        LinhasComTurnos,
				        "Codigo", [Codigo],
				        "CodigoContrato", [CodigoContrato],
				        "DescricaoContrato", [DescricaoContrato],
				        "CodigoGrupo", [CodigoGrupo],
				        "CodigoAtividade", [CodigoAtividade],
				        "CodigoProfissional", [CodigoProfissional],        
				        "Inicio", [Inicio],
				        "Fim", [Fim],
				        "Tempo", [Tempo],
				        "Horas", [Horas],
				        "DescricaoGrupo", [DescricaoGrupo],
				        "DescricaoAtividade", [DescricaoAtividade],
				        "NomeProfissional", [NomeProfissional],
				        "Email", [Email],
				        "Observacao", [Observacao],
				        "DataInc", [DataInc],
				        "Funcao", [Funcao],
				        "Cliente", [Cliente],
				        "Grupo", [Grupo]
				    )
				
				```

	annotation PBI_Id = 1b86d370675b450f9f2ee4600837cb3d

