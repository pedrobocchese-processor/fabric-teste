		displayFolder: Horas Projeto
		lineageTag: d4c28e03-c4b3-4440-b96a-18febeacb131

	measure Horas_MesAtual_Formatado = ```
			
			    VAR TotalHoras = 
			        [Horas_MesAtual] 
			    VAR Horas = 
			        INT(TotalHoras)       
			    VAR Minutos = 
			        (TotalHoras - Horas) * 60  
			    RETURN
			    FORMAT(Horas, "00") & ":" & FORMAT(Minutos, "00")
			
			```
		displayFolder: Horas Projeto
		lineageTag: f3726398-07cd-46cc-9b55-f7dd6b6899c5

	measure Horas_Consumidas = ```
			
			CALCULATE(
			    SUM(F_View_ServiceOps_Contrato_Atividade_Apontamentos[Horas]),
			    FILTER(
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos,
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[DataInc] <= TODAY()
			    )
			)
			
			```
		displayFolder: Horas Projeto
		lineageTag: 0055856e-a3c8-4802-b1d9-28630bf417ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Quantidade_Projetos = ```
			
			    DISTINCTCOUNT(F_View_ServiceOps_Contrato_Atividade_Apontamentos[DescricaoContrato])
			```
		formatString: 0
		lineageTag: cbae9721-09cf-4d0f-b838-75fa73f8d745

	measure Top1_Nome = ```
			
			VAR Ranking =
			    TOPN (
			        1,
			        SUMMARIZE (
			            F_View_ServiceOps_Contrato_Atividade_Apontamentos,
			            F_View_ServiceOps_Contrato_Atividade_Apontamentos[DescricaoCliente], 
			            "TotalHoras", [Horas_Consumidas]
			        ),
			        [TotalHoras],
			        DESC
			    )
			RETURN
			MAXX ( Ranking, F_View_ServiceOps_Contrato_Atividade_Apontamentos[DescricaoCliente] )
			
			```
		lineageTag: 7af083e1-cc10-4817-9672-92fe5d41aee1

