table Medidas
	lineageTag: 59cf5874-efa1-489d-a768-9079e722242e

	measure Horas_MesAnterior = ```
			
			    VAR MesAnterior = 
			        EOMONTH(TODAY(), -1)
			    RETURN
			    CALCULATE(
			        SUM(F_View_ServiceOps_Contrato_Atividade_Apontamentos[Horas]),
			        FILTER(
			            ALL(D_Calendario),
			            MONTH(D_Calendario[Data]) = MONTH(MesAnterior) &&
			            YEAR(D_Calendario[Data]) = YEAR(MesAnterior)
			        )
			    )
			
			```
		displayFolder: Horas Projeto
		lineageTag: 468dae39-6f68-4746-9921-95e2c772e182

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Horas_MesAtual = ```
			
			    CALCULATE(
			        SUM(F_View_ServiceOps_Contrato_Atividade_Apontamentos[Horas]),
			        FILTER(
			            ALL(D_Calendario),
			            MONTH(D_Calendario[Data]) = MONTH(TODAY()) &&
			            YEAR(D_Calendario[Data]) = YEAR(TODAY())
			        )
			    )
			
			```
		displayFolder: Horas Projeto
		lineageTag: 329138bd-0302-429c-8a7f-07e37b633fcc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DadosConsultor = ```
			
			    VAR Nome = 
			        SELECTEDVALUE(D_Funcionarios[fun_Nome])
			    VAR Cargo = 
			        SELECTEDVALUE(D_Funcionarios[car_Cargo])
			    VAR Empresa = 
			        SELECTEDVALUE(D_Funcionarios[Emp_Nome])
			
			    RETURN
			    "
			    <div style='width:350px; height:350px; background:#1e1e1e; padding:40px; font-family:sans-serif; color:white; box-sizing:border-box; display:flex; gap:20px;'>
			
			    <div style='width: 300px; padding: 24px; background: #121212; border-radius: 20px; color: white;'>
			        <h3 style='margin: 0 0 10px 0; font-size: 24px; color: white; font-weight: bold; text-align: left;'>Consultor</h3>
			        <h2 style='margin: 0; font-size: 14px;'>" & Nome & "</h2>    
			        <div style='margin-top: 20px;'>
			        <ul style='padding: 0; list-style: none; font-size: 13px; line-height: 1.6;'>
			            <li><span style='color: white; font-weight: bold;'>Cargo:</span> <span style='color: #aaa;'>" & Cargo & "</span></li>
			            <li><span style='color: white; font-weight: bold;'>Empresa:</span> <span style='color: #aaa;'>" & Empresa & "</span></li>        
			        </ul>
			        </div>            
			        
			    "
			
			```
		displayFolder: Consultor
		lineageTag: b33cb8fc-203b-43d4-91b9-acf109a14f28

