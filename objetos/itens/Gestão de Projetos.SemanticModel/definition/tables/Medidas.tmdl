	measure Funcionario_Mais_Tempo_Cartao = ```
			
			VAR MaxTempo =
			    MAXX (
			        D_Funcionarios,
			        DATEDIFF ( D_Funcionarios[fun_DataContratacao], TODAY(), YEAR )
			    )
			VAR Nome =
			    CALCULATE (
			        SELECTEDVALUE ( D_Funcionarios[fun_Nome] ),
			        FILTER (
			            D_Funcionarios,
			            DATEDIFF ( D_Funcionarios[fun_DataContratacao], TODAY(), YEAR ) = MaxTempo
			        )
			    )
			VAR Cargo =
			    CALCULATE (
			        SELECTEDVALUE ( D_Cargos[car_Cargo]),
			        FILTER (
			            D_Funcionarios,
			            DATEDIFF ( D_Funcionarios[fun_DataContratacao], TODAY(), YEAR ) = MaxTempo
			        )
			    )
			RETURN
			    Nome & UNICHAR(10)
			    & Cargo & UNICHAR(10)
			    & MaxTempo & " anos de empresa"
			
			```
		displayFolder: Consultor
		lineageTag: 27123eb4-806c-491a-a350-c1c73c98eaab

