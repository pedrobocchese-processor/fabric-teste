	column 'Período 15 Dias'
		dataType: string
		lineageTag: 0aee0334-c0c5-479a-941a-434666574f21
		summarizeBy: none
		sourceColumn: Período 15 Dias

		annotation SummarizationSetBy = Automatic

	partition D_Calendario = m
		mode: import
		source = ```
				let
				    AnoAtual = Date.Year(DateTime.Date(DateTime.LocalNow())),
				    MesAtual = Date.Month(DateTime.Date(DateTime.LocalNow())),
				    DataInicial = #date(AnoAtual - 1, 1, 1),
				    DataFinal = DateTime.Date(DateTime.LocalNow()),
				
				    QtdeDias = Duration.Days(DataFinal - DataInicial) + 1,
				    ListaDatas = List.Dates(DataInicial, QtdeDias, #duration(1, 0, 0, 0)),
				    TabelaDatas = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {"Data"}),
				
				    // Função para calcular a data da Páscoa
				    CalculaPascoa = (Ano as number) as date =>
				        let
				            a = Number.Mod(Ano, 19),
				            b = Number.IntegerDivide(Ano, 100),
				            c = Number.Mod(Ano, 100),
				            d = Number.IntegerDivide(b, 4),
				            e = Number.Mod(b, 4),
				            f = Number.IntegerDivide(b + 8, 25),
				            g = Number.IntegerDivide(b - f + 1, 3),
				            h = Number.Mod(19 * a + b - d - g + 15, 30),
				            i = Number.IntegerDivide(c, 4),
				            k = Number.Mod(c, 4),
				            l = Number.Mod(32 + 2 * e + 2 * i - h - k, 7),
				            m = Number.IntegerDivide(a + 11 * h + 22 * l, 451),
				            mes = Number.IntegerDivide(h + l - 7 * m + 114, 31),
				            dia = Number.Mod(h + l - 7 * m + 114, 31) + 1
				        in
				            #date(Ano, mes, dia),
				
				    Pascoa = CalculaPascoa(AnoAtual),
				
				    // Feriados Nacionais
				    FeriadosNacionais = {
				        #date(AnoAtual, 1, 1),      // Ano Novo
				        Pascoa,                     // Páscoa
				        Date.AddDays(Pascoa, -2),   // Sexta-feira Santa
				        #date(AnoAtual, 4, 21),     // Tiradentes
				        #date(AnoAtual, 5, 1),      // Dia do Trabalho
				        #date(AnoAtual, 9, 7),      // Independência do Brasil
				        #date(AnoAtual, 10, 12),    // Nossa Senhora Aparecida
				        #date(AnoAtual, 11, 2),     // Finados
				        #date(AnoAtual, 11, 15),    // Proclamação da República
				        #date(AnoAtual, 12, 25)     // Natal
				    },
				
				    // Feriados do Estado de São Paulo
				    FeriadosSP = {
				        #date(AnoAtual, 1, 25), // Aniversário de São Paulo
				        #date(AnoAtual, 7, 9)   // Revolução Constitucionalista
				    },
				
				    TabelaDatasAtualizada = Table.AddColumn(TabelaDatas, "Ano", each Date.Year([Data]), Int64.Type),
				    AdicionarMesNumerico = Table.AddColumn(TabelaDatasAtualizada, "n_Mes", each Date.Month([Data]), Int64.Type),
				    AdicionarNomeMes = Table.AddColumn(AdicionarMesNumerico, "Mes", each Text.Proper(Text.Start(Date.MonthName([Data]), 3)), type text),
				    AdicionarMesCompleto = Table.AddColumn(AdicionarNomeMes, "Mes Completo", each Text.Proper(Date.MonthName([Data])), type text),
				    AdicionarMesAno = Table.AddColumn(AdicionarMesCompleto, "Mes-Ano", each Text.Combine({[Mes], Text.End(Text.From([Ano], "pt-BR"), 2)}, "-"), type text),
				    AdicionarRankMesAno = Table.AddColumn(AdicionarMesAno, "Rank-Mes-Ano", each 100 * [Ano] + [n_Mes], Int64.Type),
				    AlterarTipo = Table.TransformColumnTypes(AdicionarRankMesAno, {{"Data", type date}}),
				    AdicionarDia = Table.AddColumn(AlterarTipo, "Dia", each Date.Day([Data]), Int64.Type),
				    AdicionarDiaSemana = Table.AddColumn(AdicionarDia, "Dia da Semana", each Date.DayOfWeekName([Data])),
				    AdicionarOrdemDiaSemana = Table.AddColumn(AdicionarDiaSemana, "Ordem Dia Semana", each Date.DayOfWeek([Data]) + 1),
				    ColocarCadaPalavraEmMaiuscula = Table.TransformColumns(AdicionarOrdemDiaSemana,{{"Mes", Text.Proper, type text}, {"Dia da Semana", Text.Proper, type text}}),
				    AdicionarDataFormatada = Table.AddColumn(ColocarCadaPalavraEmMaiuscula, "DataFormatada", each Text.From([Dia]) & "/" & Text.From([n_Mes]) & "/" & Text.From([Ano])),
				
				    // Adicionando "Mês Atual"
				    AdicionarMesAtual = Table.AddColumn(AdicionarDataFormatada, "Mês Atual", each 
				        if [Ano] = AnoAtual and [n_Mes] = MesAtual then "Atual" else [Mes], type text),
				
				    // Adicionando "Ano Atual"
				    AdicionarAnoAtual = Table.AddColumn(AdicionarMesAtual, "Ano Atual", each 
				        if [Ano] = AnoAtual then "Atual" else Text.From([Ano]), type text),
				
				    // Adicionando colunas de Período de 15 Dias
				    AdicionarPeriodo15Dias = Table.AddColumn(AdicionarAnoAtual, "Início Período 15 Dias", each 
				        let
				            diasPassados = Duration.Days([Data] - DataInicial),
				            grupo = Number.IntegerDivide(diasPassados, 15),
				            dataInicio = Date.AddDays(DataInicial, grupo * 15)
				        in
				            dataInicio
				    , type date),
				
				    AdicionarFimPeriodo15Dias = Table.AddColumn(AdicionarPeriodo15Dias, "Fim Período 15 Dias", each 
				        Date.AddDays([Início Período 15 Dias], 14), type date),
				
				    AdicionarPeriodoTexto = Table.AddColumn(AdicionarFimPeriodo15Dias, "Período 15 Dias", each 
				        Text.PadStart(Text.From(Date.Day([Início Período 15 Dias])), 2, "0") & "/" &
				        Text.PadStart(Text.From(Date.Month([Início Período 15 Dias])), 2, "0") & "/" &
				        Text.From(Date.Year([Início Período 15 Dias])) & " a " &
				        Text.PadStart(Text.From(Date.Day([Fim Período 15 Dias])), 2, "0") & "/" &
				        Text.PadStart(Text.From(Date.Month([Fim Período 15 Dias])), 2, "0") & "/" &
				        Text.From(Date.Year([Fim Período 15 Dias]))
				    , type text),
				
				    // Verificar se é dia útil
				    AdicionarDiaUtil = Table.AddColumn(AdicionarPeriodoTexto, "Dia Útil", each
				        if List.Contains(FeriadosNacionais, [Data]) or List.Contains(FeriadosSP, [Data]) or Date.DayOfWeek([Data]) = 0 or Date.DayOfWeek([Data]) = 6 then "Não"
				        else "Sim"
				    ),
				
				    #"Linhas Classificadas" = Table.Sort(AdicionarDiaUtil,{{"Data", Order.Descending}}),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Linhas Classificadas", "Data", "Data - Copiar"),
				    #"Colunas Reordenadas" = Table.ReorderColumns(#"Coluna Duplicada",{
				        "Data", "Data - Copiar", "Ano", "n_Mes", "Mes", "Mes Completo", "Mes-Ano", "Rank-Mes-Ano", 
				        "Dia", "Dia da Semana", "Ordem Dia Semana", "DataFormatada", "Mês Atual", "Ano Atual",
				        "Início Período 15 Dias", "Fim Período 15 Dias", "Período 15 Dias", "Dia Útil"
				    }),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Reordenadas",{{"Data - Copiar", type text}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado",{{"Data - Copiar", "Data_Filter"}})
				in
				    #"Colunas Renomeadas"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

