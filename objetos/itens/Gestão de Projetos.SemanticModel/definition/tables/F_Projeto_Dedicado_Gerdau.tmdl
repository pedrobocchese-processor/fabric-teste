	column Turno
		lineageTag: 15eb4ec6-b346-4c47-bf43-bd9395db24be
		summarizeBy: none
		isNameInferred
		sourceColumn: [Turno]

		annotation SummarizationSetBy = Automatic

	partition F_Projeto_Dedicado_Gerdau = calculated
		mode: import
		source = ```
				
				VAR DiasUteis =
				    FILTER (
				        ADDCOLUMNS (
				            CALENDAR (DATE (2025, 1, 1), DATE (2025, 12, 31)),
				            "DiaSemana", WEEKDAY ([Date], 2),
				            "Mes", MONTH ([Date])
				        ),
				        [DiaSemana] <= 5
				    )
				
				VAR DiasIndexados =
				    ADDCOLUMNS (
				        DiasUteis,
				        "IdxDia",
				            RANKX (DiasUteis, [Date],, ASC, DENSE)
				    )
				
				VAR LinhasComTurnos =
				    ADDCOLUMNS (
				        GENERATE (
				            DiasIndexados,
				            DATATABLE ("Turno", STRING, { { "Manhã" }, { "Tarde" } })
				        ),
				        "Codigo",
				            35730 + ( [IdxDia] - 1 ) * 2 + IF ( [Turno] = "Tarde", 1, 0 ),
				        "CodigoContrato", 7022,
				        "DescricaoContrato", "7022 - Contrato de Consultoria",
				        "CodigoGrupo", 152,
				        "CodigoAtividade", BLANK(),
				        "CodigoProfissional",
				            IF ([Mes] <= 7, 2998, 3474),
				        "NomeProfissional",
				            IF ([Mes] <= 7, "Mario Ronca de Paula", "Bruna Luzia Santos Wehrmann"),
				        "Email",
				            IF ([Mes] <= 7, "mario.paula@gotobiz.com.br", "bruna.wehrmann@processor.com.br"),
				        "Inicio",
				            IF ([Turno] = "Manhã",
				                [Date] + TIME (8, 0, 0),
				                [Date] + TIME (13, 0, 0)
				            ),
				        "Fim",
				            IF ([Turno] = "Manhã",
				                [Date] + TIME (12, 0, 0),
				                [Date] + TIME (17, 0, 0)
				            ),
				        "Horas", 4,
				        "Tempo", TIME (4, 0, 0),
				        "DescricaoGrupo", "Projeto Dedicado",
				        "DescricaoAtividade", "Atendimento Projeto Dedicado",
				        "Observacao", "Atendimento projeto dedicado Gerdau",
				        "DataInc", [Date] + TIME (8, 0, 0),
				        "Cliente", "GERDAU ACOS LONGOS S.A.",
				        "Grupo", "Gerdau",
				        "Funcao",
				            IF (
				                [Mes] <= 7,
				                "Consultor Técnico - Pl",
				                "Analista de Processos e Sistemas - Jr"
				            )
				    )
				
				-- Adiciona índice de turno para cada profissional/mês
				VAR LinhasIndexadas =
				    ADDCOLUMNS (
				        LinhasComTurnos,
				        "IdxTurno",
				            RANKX (
				                FILTER (
				                    LinhasComTurnos,
				                    [Mes] = EARLIER ([Mes])
				                        && [NomeProfissional] = EARLIER ([NomeProfissional])
				                ),
				                [Date] & [Turno],
				                ,
				                ASC,
				                DENSE
				            )
				    )
				
				-- Limita para 160h/mês (ou 40 turnos = 4h cada)
				VAR LinhasLimitadas =
				    FILTER (
				        LinhasIndexadas,
				        [IdxTurno] <= 40
				    )
				
				RETURN
				    SELECTCOLUMNS (
				        LinhasLimitadas,
				        "Codigo", [Codigo],
				        "CodigoContrato", [CodigoContrato],
				        "DescricaoContrato", [DescricaoContrato],
				        "CodigoGrupo", [CodigoGrupo],
				        "CodigoAtividade", [CodigoAtividade],
				        "CodigoProfissional", [CodigoProfissional],
				        "NomeProfissional", [NomeProfissional],
				        "Funcao", [Funcao],
				        "Email", [Email],
				        "Inicio", [Inicio],
				        "Fim", [Fim],
				        "Tempo", [Tempo],
				        "Horas", [Horas],
				        "DescricaoGrupo", [DescricaoGrupo],
				        "DescricaoAtividade", [DescricaoAtividade],
				        "Observacao", [Observacao],
				        "DataInc", [DataInc],
				        "Cliente", [Cliente],
				        "Grupo", [Grupo],
				        "Turno", [Turno]
				    )
				
				```

	annotation PBI_Id = 0bdaa86b8d3b4d8a94527142e477fdf8

