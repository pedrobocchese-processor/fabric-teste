	partition D_Funcionarios = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("10.15.0.20\mssqlsip", "Processor", [Query="SELECT F.fun_Codigo#(lf)#(tab)  ,F.fun_Nome#(lf)#(tab)  ,F.fun_NomeCompleto#(lf)#(tab)  ,F.fun_Cargo#(lf)#(tab)  ,C.car_Cargo#(lf)#(tab)  ,CONVERT(DATE,F.fun_DataContratacao) AS fun_DataContratacao#(lf)#(tab)  ,CONVERT(DATE,F.fun_DataEfetivacao) AS fun_DataEfetivacao#(lf)#(tab)  ,F.fun_Empresa#(lf)#(tab)  ,E.Emp_Nome#(lf)#(tab)  ,F.fun_Ativo#(lf)#(tab)  ,F.fun_Area#(lf)#(tab)  ,A.are_Descricao#(lf)#(tab)  ,F.fun_Superior#(lf)#(tab)  ,CONVERT(DATE,F.fun_DataNascimento) AS fun_DataNascimento#(lf)#(tab)FROM Funcionarios F#(lf)#(tab)#(tab)JOIN Cargos C ON C.car_Codigo = F.fun_Cargo#(lf)#(tab)#(tab)JOIN Empresa E ON E.Emp_Codigo_Empresa = F.fun_Empresa#(lf)#(tab)#(tab)LEFT JOIN Areas A ON A.are_Codigo_Area = F.fun_Area#(lf)#(tab)WHERE F.fun_Ativo = 1#(lf)#(tab)#(tab)AND F.fun_Codigo IN ( 3484, 2680, 3474, 1080, 3175, 2680, 2998)"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"fun_DataContratacao", type date}, {"fun_DataEfetivacao", type date}}),
				    #"Linhas Classificadas" = Table.Sort(#"Tipo Alterado",{{"fun_Nome", Order.Ascending}})
				in
				    #"Linhas Classificadas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

