	column fun_TempoEmpresa = ```
			
			    DATEDIFF (
			        D_Funcionarios[fun_DataContratacao],
			        TODAY(),
			        YEAR
			    )
			```
		formatString: 0
		lineageTag: f5712fd5-c19e-4ec7-8ffe-e7a2f22ae2d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column fun_TempoEmpresaGrupo = ```
			
			    SWITCH (
			        TRUE(),
			        D_Funcionarios[fun_TempoEmpresa] < 1, "0 a 1 ano",
			        D_Funcionarios[fun_TempoEmpresa] >= 1 && D_Funcionarios[fun_TempoEmpresa] < 3, "1 a 3 anos",
			        D_Funcionarios[fun_TempoEmpresa] >= 3 && D_Funcionarios[fun_TempoEmpresa] < 5, "3 a 5 anos",
			        D_Funcionarios[fun_TempoEmpresa] >= 5 && D_Funcionarios[fun_TempoEmpresa] < 10, "5 a 10 anos",
			        D_Funcionarios[fun_TempoEmpresa] >= 10, "10+ anos",
			        BLANK()
			    )
			
			```
		lineageTag: 663b517c-63a5-41cf-b683-082e480ff31d
		summarizeBy: none

