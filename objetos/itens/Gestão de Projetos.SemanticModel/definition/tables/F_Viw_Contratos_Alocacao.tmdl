	partition F_Viw_Contratos_Alocacao = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("10.15.0.20\mssqlsip", "Processor", [Query="SELECT *#(lf)#(tab)FROM [viw_Contratos_Alocacao] CA#(lf)#(tab)WHERE CA.cod_fun IN ( 3484, 2680, 3474, 1080, 3175, 2680, 2998)#(lf)#(tab)  AND YEAR(CA.Data_Registro) IN (YEAR(GETDATE()), YEAR(GETDATE()) - 1)"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Data_Registro", type date}}),
				    #"Linhas Classificadas" = Table.Sort(#"Tipo Alterado",{{"Data_Registro", Order.Descending}})
				in
				    #"Linhas Classificadas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

