	column DescricaoCliente = ```
			
			    SWITCH (
			        TRUE(),
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Via Loterias S.A", "Via Loterias",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Gerdau Acos Longos S.A.", "Gerdau",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Gerdau Acos Longos Sa", "Gerdau",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Renove Corretora De Seguros Limitada", "Itavema",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Intral Sa Industria De Materiais Eletricos", "Intral",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "PRECATO CONSULTORIA S.A.", "Precato",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "RODOIL DISTRIBUIDORA DE COMBUSTIVEIS S.A.", "Rodoil",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "TRAIL INFRAESTRUTURA LTDA", "Tejofran",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "Car House", "Car House",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "PROCESSOR SOLUCOES TECNOLOGICAS PARA NEGOCIOS LTDA", "Jornada de Dados Processor",
			        F_View_ServiceOps_Contrato_Atividade_Apontamentos[Cliente] = "ANBIMA - ASSOCIACAO BRASILEIRA DAS ENTIDADES DOS MERCADOS FINANCEIRO E DE CAPITAIS", "Anbima",
			        "Não informado"
			    )
			
			```
