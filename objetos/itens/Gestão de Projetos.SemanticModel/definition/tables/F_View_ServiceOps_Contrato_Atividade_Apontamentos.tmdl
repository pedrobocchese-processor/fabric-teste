	partition F_View_ServiceOps_Contrato_Atividade_Apontamentos = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("10.15.0.20\mssqlsip", "Processor", [Query="SELECT vs.*#(lf)      ,cli.Cli_Razao_Social AS Cliente#(lf)      ,grp.Grp_Descricao AS Grupo  #(lf)   FROM ViewServiceOpsContratoAtividadeApontamentos vs#(lf)      INNER JOIN Contratos con ON CodigoContrato = con.con_Codigo_Contrato#(lf)      INNER JOIN Clientes cli#(tab) ON Con.con_Contratante = cli.Cli_Codigo_Cliente#(lf)      INNER JOIN Clientes_Grupos grp ON cli.Cli_Codigo_Grupo = grp.Grp_Codigo_Grupo#(lf)   WHERE YEAR(VS.DataInc) IN (YEAR(GETDATE()), YEAR(GETDATE()) - 1)#(lf)      "]),
				    #"Linhas Filtradas" = Table.SelectRows(Fonte, each ([CodigoProfissional] <> 3195)),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Linhas Filtradas", "DataInc", "DataInc - Copiar"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna Duplicada",{{"DataInc", type date}, {"DataInc - Copiar", type time}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado",{{"DataInc - Copiar", "HoraDataInc"}}),
				    #"Colocar Cada Palavra Em Maiúscula" = Table.TransformColumns(#"Colunas Renomeadas",{{"Cliente", Text.Proper, type text}, {"Grupo", Text.Proper, type text}, {"DescricaoContrato", Text.Proper, type text}}),
				    #"Consulta Acrescentada" = Table.Combine({#"Colocar Cada Palavra Em Maiúscula", F_Projeto_Dedicado}),
				    #"Linhas Filtradas1" = Table.SelectRows(#"Consulta Acrescentada", each ([NomeProfissional] <> "Douglas Gaigher"))
				in
				    #"Linhas Filtradas1"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

