	partition dCalendario-622bdcf9-567a-4236-82de-b79a53380996 = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS( CALENDAR(DATE(2022,01,01), DATE(2030,12,31)),
				                "Ano", YEAR([Date]),
				                "Mes Num", MONTH([Date]),
				                "Ordem", FORMAT([Date], "yymm"),
				                "Ordem2", FORMAT([Date], "yymmdd"),
				                "Trimestre",QUARTER([Date])&"° Trim",
				                "Mes Completo",FORMAT([Date],"mmm", "pt-BR"))
				
				```

	annotation PBI_Id = f53e30acd5014027a7cc9fdf013e630b

