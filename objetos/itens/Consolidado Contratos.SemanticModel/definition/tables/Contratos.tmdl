	partition Contratos-1b2a526d-1228-414c-b275-378e6471f459 = m
		mode: import
		queryGroup: Dimensoes
		source = ```
				let
				    Fonte = Sql.Database("gage.processor.com.br\mssqlsip", "processor", [Query="SELECT * from sipm.vw_BI_Contratos_v1", CommandTimeout=#duration(0, 4, 0, 0)]),
				    #"Personalização Adicionada" = Table.AddColumn(Fonte, "Problema com contratos", each if [Status do contrato] = "Ativo" and [Data de renovação] <> null
				            then null
				            else if [Status do contrato] = "Ativo" and [Data de renovação] = null and [Data de revisão] = null and [Data de inativação] = null
				                then "Ativo e sem data de início, revisão e renovação" 
				                else if [Status do contrato] = "Ativo" and Date.Year([Data de renovação]) = 2099
				                    then "Ativo e com data de renovação em 2099"
									else if Date.Year([Data de início]) = 1900
										then "Data de início em 1900"
										else if [Status do contrato] = "Inativo" and [Data de renovação] <> null 
											then null
											else if [Status do contrato] = "Inativo" and [Data de renovação] <> null and [Data de renovação] > DateTime.Date(Date.From(DateTime.LocalNow()))
												then "Inativo com data de renovação posterior ao dia de hoje" 
												else if [Status do contrato] = "Inativo" and [Data de renovação] = null and [Data de inativação] <> null 
													then "Inativo e sem data de renovação"
													else if [Status do contrato] = "Inativo" and [Data de renovação] = null and [Data de inativação] = null and [Data de revisão] <> null
														then "Inativo sem data de renovação e inativação"
														else null),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Personalização Adicionada",{{"Data de início", type date}, {"Data de renovação", type date}, {"Data de revisão", type date}, {"Data de inativação", type date}, {"Data do primeiro pedido", type date}, {"Data do último pedido", type date}, {"Última data", type date}, {"Início da vigência", type date}, {"Fim da vigência", type date}})
				in
				    #"Tipo Alterado"
				```

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegação

