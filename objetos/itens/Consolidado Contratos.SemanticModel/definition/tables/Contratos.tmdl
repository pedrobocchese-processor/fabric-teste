table Contratos
	lineageTag: c3d7a86a-b347-442f-9647-32b3c1a676f6

	measure 'Total Contratos Ativos' =
			
			CALCULATE(
			    DISTINCTCOUNT(Contratos[ID do contrato]),
			    FILTER(Contratos,Contratos[Status do contrato] = "Ativo" && Contratos[Fim da vigência] >= TODAY()))
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 4688558f-0730-4979-8eec-012ec5127db2

	measure 'Total Cliente' = DISTINCTCOUNT(Contratos[ID do cliente])
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: e638099f-8dab-4afd-a416-3e1b629fcc82

	measure 'Total Clientes Inativos' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( Contratos[Id do Cliente] ),
			    FILTER ( Contratos, Contratos[Status do contrato] = "Inativo" ),
			    FILTER (
			        SUMMARIZE (
			            Contratos,
			            Contratos[Id do Cliente],
			            "@Count", COUNTROWS ( Contratos )
			        ),
			        [@Count]
			            = CALCULATE ( COUNTROWS ( Contratos ), Contratos[Status do contrato] = "Inativo" )
			    )
			)
			
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 97380d96-410f-4858-9ea8-1096e2fe54fe

	measure 'Total Clientes Ativos' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( Contratos[ID do cliente] ),
			    FILTER ( Contratos, Contratos[Status do contrato] = "Ativo" ),
			    FILTER (
			        SUMMARIZE (
			            Contratos,
			            Contratos[ID do cliente],
			            "@Count", COUNTROWS ( Contratos )
			        ),
			        [@Count]
			            = CALCULATE ( COUNTROWS ( Contratos ), Contratos[Status do contrato] = "Ativo" )
			    )
			)
			
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 62b6d3b0-0861-4e12-acbd-eaa2b697ee2c

	measure 'Total Contratos Inativos' =
			
			CALCULATE(
			    DISTINCTCOUNT(Contratos[ID do contrato]),
			    Contratos[Status do contrato] = "Inativo")
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: c01d2cde-25b2-4b2a-b371-a44b4a18d6ca

	measure 'Contratos Novos' = ```
			
			CALCULATE([Total Contratos Ativos], 
			    USERELATIONSHIP(dCalendario[Date],Contratos[Início da vigência]))
			```
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: ca146466-b003-4878-80c8-e44d6b073ae2

	measure 'Contratos Inativados / Perdidos' = ```
			
			CALCULATE([Total Contratos Inativos]  , 
			                 USERELATIONSHIP(dCalendario[Date],Contratos[Data de inativação]))
			
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: be137dd6-0f55-44a7-9b3b-76b9c2b23514

	measure '% Churn Contratos' = DIVIDE([Contratos Inativados / Perdidos],[Total Contratos Ativos])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _Medidas
		lineageTag: ee6e44df-55a6-4add-84e1-1a39dadb1b94

