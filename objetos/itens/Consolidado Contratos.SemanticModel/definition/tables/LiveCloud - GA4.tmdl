 Basic e Premium" else if Text.Contains([Page], "/MaxOutSource/") then "Max Outsource" else if Text.Contains([Page], "/MonitoringDashboard") then "LiveWatch" else if Text.Contains([Page], "/notasFiscais") then "Notas Fiscais e Contratos" else if Text.Contains([Page], "/retencao/") then "LC Retenção" else if Text.Contains([Page], "/BackupSaasV2") then "LC SaaS Backup" else if Text.Contains([Page], "/SaaS") then "SaaS Premium" else if Text.Contains([Page], "/webpresence/") then "LC CMS Premier" else if Text.Contains([Page], "/costcenterdashboard/17") then "LC CMS Enterprise" else if Text.Contains([Page], "/costcenterdashboard/2") then "LC CMS Premier" else if Text.Contains([Page], "/costcenterdashboard/6") then "LC CMS Corporate" else if Text.Contains([Page], "/costcenterdashboard/analitico/17") then "LC CMS Enterprise" else if Text.Contains([Page], "/costcenterdashboard/analitico/2") then "LC CMS Premier" else if Text.Contains([Page], "/costcenterdashboard/analitico/6") then "LC CMS Corporate" else if Text.Contains([Page], "/DisasterRecovery/") then "LC Disaster Recovery" else if Text.Contains([Page], "/backupsilver/") then "LC Backup Basic" else if Text.StartsWith([Page], "/saas/") then "SaaS Premium" else if Text.Contains([Page], "/VinSubscriptionToEA") then "Softwares.com.br" else if [Page] = "/" then "Página Inicial" else if Text.Contains([Page], "/Chamados") then "Criar e Acompanhar Chamados" else if [Page] = "/solucoes" then "Página Inicial" else if [Page] = "/Perfis" then "Configurações" else if Text.Contains([Page], "/Cms") then "LC CMS" else if Text.Contains([Page], "/cms") then "LC CMS" else if [Page] = "/Usuarios" then "Configurações" else if [Page] = "/WebSites" then "LC CMS Premier" else if [Page] = "/gtmconfiguration" then "Configurações" else if [Page] = "/administration/HealthCheckActiveService" then "HealthCheck" else if Text.Contains([Page], "/patchmanager") then "Patch Manager" else null),
