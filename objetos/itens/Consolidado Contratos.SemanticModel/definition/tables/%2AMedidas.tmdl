	measure Churn_Final = ```
			
			var Selecao1 = SELECTEDVALUE(dCalendario[Mes Completo])
			var Selecao2  = DATEDIFF(min(dCalendario[Date]),max(dCalendario[Date]),MONTH)+1
			RETURN
			SWITCH(
			    TRUE(),
			    AND(ISBLANK(Selecao1),Selecao2 =12),[Churn_Multiple],
			    [Churn_Simple]
			) 
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 88279eda-480e-47a8-b109-a1d0d59b3dc5

	measure Cancelados_Final = ```
			
			
			var Selecao = SELECTEDVALUE(dCalendario[Mes Completo])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Selecao),[Cancelados_Multiple],
			    [Cancelados_Simple]
			)    
			
			```
		formatString: 0
		lineageTag: cb09c2aa-9cc2-4490-ae0d-7afec4dc6c95

	measure Cancelados_Multiple = ```
			
			VAR Dif_Day     = DATEDIFF(MIN(dCalendario[Date]),MAX(dCalendario[Date]),DAY)
			var DataFim     = MIN(dCalendario[Date]) - 1
			var DataIni     = MIN(dCalendario[Date]) - (Dif_Day+1)
			VAR QtdAnter    = 
			    CALCULATE(
			    [Qtd_Clientes],
			    DATESBETWEEN(dCalendario[Date],DataIni,DataFim))
			
			var QtdAtual =  [Qtd_Clientes]
			var Variacao =  QtdAtual - QtdAnter
			var QtdCliPerd = IF(Variacao < 0 , Variacao * -1 ,0)
			
			return
			QtdCliPerd 
			
			```
		formatString: 0
		lineageTag: 19463e8f-b778-4deb-8d1c-0f4dfb6e707f

	measure 'Qtd Acumulada Clientes' = ```
			
			
			var DataIni    = DATEADD(FIRSTDATE(dCalendario[Date]),-1,MONTH)
			var DataFim    = DataIni+27
			var Resultado  =
			    CALCULATE(
			            [Qtd_Clientes],
			            filter(
			                all(dCalendario),
			                and(dCalendario[Date] >= DataIni , dCalendario[Date] <= DataFim))
			            )
			return
			Resultado
			
			```
		formatString: 0
		lineageTag: 732a8fb1-1f90-47c7-b914-8ef5ca579b6a

	measure Qtd_Clientes_Anter = ```
			
			CALCULATE( 
			    [Qtd_Clientes], 
			    'Contratos dia a dia'[Razão do status] IN { "Ativo", "Ativo vencido" },
			    REMOVEFILTERS('Contratos dia a dia'[Fab_Nome_Fabricante]),
			    DATEADD(FIRSTDATE(dCalendario[Date]),-1,MONTH)
			)
			```
		formatString: 0
		lineageTag: cb626fea-b7b6-41fe-8bb4-9a505feba6d1

	measure 'Qtd Novos Clientes' = ```
			
			VAR DistinctGroups = 
			    DISTINCT('Contratos dia a dia'[ID do grupo])
			
			VAR NewClientsCount = 
			    COUNTROWS(
			        FILTER(
			            DistinctGroups,
			            ISBLANK(
			                CALCULATE([Qtd_Clientes_Anter])
			            )
			        )
			    )
			
			RETURN
			    COALESCE(NewClientsCount, 0)
			```
		formatString: 0
		lineageTag: 261a3f66-03fd-4b66-bc75-3c37ec7bceb5

	measure 'Qtd Perdidos Clientes' = ```
			
			var Resultado = 
			COUNTROWS(
			    FILTER(
			      ALL('Contratos dia a dia'[ID do grupo]),
			        IF(
			        [Qtd_Clientes] = 0 &&
			        [Qtd_Clientes_Anter] > 0 &&
			        [ClienteAtivo] <> "1" ,
			        1,0) 
			    = 1  )
			)
			return
			Resultado
			```
		formatString: 0
		lineageTag: 55ec26a5-5a5a-4e70-92e8-beb7cb48c7ae

	measure Medida = ```
			
			SUMX(
			ADDCOLUMNS(
			  VALUES('Contratos dia a dia'[Data]),
			  "Tot",[Qtd Novos Clientes]), [Tot])
			
			```
		formatString: 0
		lineageTag: 329e165f-08ab-4900-86e5-d7b5eb618446

	measure 'Qtd Acumulada Perdidos' =
			
			var DataIni    = DATEADD(FIRSTDATE(dCalendario[Date]),-1,MONTH)
			var DataFim    = DataIni+27
			var Resultado  =
			sumx(
			    ALL(dCalendario[Mes Completo]),
			    ([Qtd_Clientes_Anter]+[Qtd Novos Clientes])-[Qtd_Clientes] )
			return
			Resultado
		formatString: 0
		lineageTag: 4597fe06-8ef6-46f8-ba8b-7172967b4c55

	measure 'Qtd Perdidos Final' = ```
			
			var Selecao1 = SELECTEDVALUE(dCalendario[Mes Completo])
			var Selecao2  = DATEDIFF(min(dCalendario[Date]),max(dCalendario[Date]),MONTH)+1
			RETURN
			SWITCH(
			    TRUE(),
			    AND(ISBLANK(Selecao1),Selecao2 =12),[Qtd Acumulada Perdidos],
			    [Qtd Perdidos Clientes]
			) 
			```
		formatString: 0
		lineageTag: acb13be8-39ce-47cd-bad8-c9917c03b759

