	measure Churn_Simple = ```
			
			var QtdAnter = [Qtd_Clientes_Anter]
			var QtdAtual = [Qtd_Clientes]
			var QtdNovo  = [Qtd Novos Clientes]
			var QtdPerd  = [Qtd Perdidos Clientes]
			var Divisor  = QtdNovo+QtdAnter
			Return
			DIVIDE(QtdPerd,Divisor)
			
			```
		lineageTag: b7bb71ce-0259-4c94-a149-994c1e65d8b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cancelados_Simple = ```
			
			var QtdAnter = CALCULATE([Qtd_Clientes],DATEADD(dCalendario[Date],-1,MONTH))  
			var QtdAtual = [Qtd_Clientes]
			var Variacao =  QtdAtual - QtdAnter
			var QtdCliPerd = IF(Variacao < 0 , Variacao * -1 , 0)
			Return
			QtdCliPerd
			```
		lineageTag: ccf41e82-8e2f-4c4d-8520-bee0bbc9a409

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Qtd_Clientes = ```
			
			var Calculo = 
			CALCULATE(
			  DISTINCTCOUNTNOBLANK(
			        'Contratos dia a dia'[ID do grupo]), 
			            AND('Contratos dia a dia'[ID do contrato] > 0,
			            'Contratos dia a dia'[Flag_Retroceder] = 0
			    )
			)
			return
			IF(Calculo < 0 , 0 ,Calculo)
			```
		formatString: 0
		lineageTag: a7a57597-c319-48ec-bfc6-6560b2542832

