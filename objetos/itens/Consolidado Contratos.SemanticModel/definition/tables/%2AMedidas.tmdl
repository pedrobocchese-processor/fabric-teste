	measure 'Medida 2'
		lineageTag: 12f1f804-aec9-4050-95a6-0058d3eee66c

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Classificacao Score' =
			
			SWITCH(
			        TRUE(),
			        ISBLANK([Media Sentiment Score]), BLANK(),
			        [Media Sentiment Score] < 7 ,"Negativo",
			        [Media Sentiment Score] < 9 ,"Neutro",
			        "Positivo"
			)
		lineageTag: cefcfd29-f37f-4ba5-9504-719549f61b5a

	measure 'Total Grupos LiveCloud' =
			
			var vPage = CALCULATE(
			    DISTINCTCOUNT('LiveCloud - GA4'[Grupo Economico SIP ID]),
			    'LiveCloud - GA4'[Usuário Externo] = "1",
			    USERELATIONSHIP('Contratos dia a dia'[ID do grupo],'LiveCloud - GA4'[Grupo Economico SIP ID])
			)
			
			var vContrato = [Qtd. Contratos Ativos]
			RETURN
			IF( vContrato >= 1, COALESCE(vPage,0),BLANK())
		formatString: 0
		lineageTag: e341f0ce-7901-479f-9511-d0edc795e69a

	column -
		lineageTag: d1999a0a-8651-4e0c-b243-d4b7e26080f1
		summarizeBy: none
		isNameInferred
		sourceColumn: [-]

		annotation SummarizationSetBy = Automatic

