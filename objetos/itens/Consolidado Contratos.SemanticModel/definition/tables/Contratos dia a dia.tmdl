			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: edad13e0-b257-4c60-9ef3-4212e885482f

	measure 'Qtd. Contratos LM' = CALCULATE([Qtd. Contratos],PREVIOUSMONTH(dCalendario[Date]))
		formatString: 0
		displayFolder: _Medidas
		lineageTag: b10be95e-dfc5-4a10-b0a2-a1964ae0e6d2

	measure 'Média Total Grupo Cliente Ativo' = ```
			
			VAR AnoSelecionado = YEAR(MAX('dCalendario'[Date]))
			VAR Qtdmeses = 
			    COUNTROWS(VALUES('dCalendario'[Mes Completo]))
			VAR mes1 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 1
			)
			VAR mes2 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 2
			)
			VAR mes3 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 3
			)
			VAR mes4 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 4
			)
			VAR mes5 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 5
			)
			VAR mes6 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 6
			)
			VAR mes7 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 7
			)
			VAR mes8 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 8
			)
			VAR mes9 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 9
			)
			VAR mes10 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 10
			)
			VAR mes11 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 11
			)
			VAR mes12 = CALCULATE(
			    [Total Grupo Cliente Ativo],
			    YEAR('Contratos dia a dia'[Data]) = AnoSelecionado && MONTH('Contratos dia a dia'[Data]) = 12
			)
			RETURN 
			DIVIDE(mes1 + mes2 + mes3 + mes4 + mes5 + mes6 + mes7 + mes8 + mes9 + mes10 + mes11 + mes12, Qtdmeses, 0)
			
			```
		formatString: 0.00
		displayFolder: _Medidas
		lineageTag: 75163e56-33d7-43e5-ae16-20caecd6c0eb

	measure 'Churn Acumulado' = ```
			
			VAR Qtdmeses =
			    COUNTROWS ( VALUES ( 'dCalendario'[Mes Completo] ) )
			RETURN
			    IF (
			        Qtdmeses = 1,
			        [% Churn Grupo Clientes],
			        IF (
			            Qtdmeses = 12,
			            CALCULATE (
			                DIVIDE (
			                    [Média Total Grupo Cliente Ativo LY] - [Média Total Grupo Cliente Ativo],
			                    [Média Total Grupo Cliente Ativo LY]
			                )
			            ),
			            CALCULATE (
			                DIVIDE (
			                    [Média Total Grupo Cliente Ativo LQT] - [Média Total Grupo Cliente Ativo],
			                    [Média Total Grupo Cliente Ativo LQT]
			                )
			            )
			        )
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _Medidas
		lineageTag: 92328436-f200-476a-8c3c-8fb9d40392ad

	measure 'Média Total Grupo Cliente Ativo LQT' = CALCULATE([Média Total Grupo Cliente Ativo],PREVIOUSQUARTER(dCalendario[Date]))
		displayFolder: _Medidas
		lineageTag: 80fd10ca-ebe9-4586-acb3-ea7d4e94ccbe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média Total Grupo Cliente Ativo LY' = CALCULATE([Média Total Grupo Cliente Ativo],PREVIOUSYEAR(dCalendario[Date]))
