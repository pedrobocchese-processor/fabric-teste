table 'Contratos dia a dia'
	lineageTag: 021128b0-569d-4eb8-b7f8-27ab7d86f9c0

	measure 'Valor Contratos' = CALCULATE(SUM('Contratos dia a dia'[Valor do pedido]))
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: 39dbd952-72ff-4d08-bf3e-562d4f4f4c63

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Qtd. Novos Contratos' = ```
			
			    CALCULATE([Qtd. Contratos Ativos],
			        USERELATIONSHIP(dCalendario[Date],'Contratos dia a dia'[Início da vigência]))
			        
			```
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: 4cc0049c-14ec-4da4-8f61-4a138fa66f3a

	measure 'Qtd. Contratos Inativos' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('Contratos dia a dia'[ID do contrato]),
			        'Contratos dia a dia'[Razão do status] IN {"Inativo", "Inativo com data válida"}
			)
			
			```
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: f665cd38-fd62-4849-b7d6-cbd099481613

	measure '% Churn Contratos dia a dia' = ```
			
			VAR Contratos_Ativos_Mes_Anterior = CALCULATE([Qtd. Contratos Ativos], DATEADD('dCalendario'[Date], -1, MONTH))
			
			VAR Churn_Mes_Atual = [Qtd. Contratos Inativos]
			
			RETURN
			DIVIDE(Churn_Mes_Atual, Contratos_Ativos_Mes_Anterior)
			
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: _Medidas
		lineageTag: 1d6c0253-3c5f-4f92-af72-3658a70ba256

	measure '% Churn Grupo Clientes' = ```
			
			 ABS(CALCULATE(
			    DIVIDE([Média Total Grupo Cliente Ativo] , [Qtd_Clientes_Anter] + [Qtd Novos Clientes],0)) -1)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _Medidas
		lineageTag: fe17a105-801c-4aa6-958f-65dd998abf15

	measure 'Qtd. Contratos' =
			
			CALCULATE(
			    DISTINCTCOUNT('Contratos dia a dia'[ID do contrato]))
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: 044e80df-49aa-4a6b-bdfe-74620a57ed20

	measure 'Valor Novos Contratos' =
			
			CALCULATE(
			    SUM('Contratos dia a dia'[Valor do pedido]),
			    'Contratos dia a dia'[Razão do status] = "Ativo",
			    USERELATIONSHIP(dCalendario[Date],'Contratos dia a dia'[Início da vigência])
			    )
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: a4642690-4046-4423-bb9b-349ff2689584

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Total Grupo Cliente Ativo' =
			
			CALCULATE(
			    DISTINCTCOUNT('Contratos dia a dia'[ID do grupo]),
			    'Contratos dia a dia'[Razão do status] IN { "Ativo", "Ativo vencido" } )
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: 70b9badf-e55c-419b-bacb-4e36f9caaadf

	measure 'Valor Inativados' = ```
			
			CALCULATE (
			    SUM('Contratos dia a dia'[Valor do pedido]), 
			    FILTER (
			        SUMMARIZE (
			            ALLSELECTED('Contratos dia a dia'[ID do grupo], 'Contratos dia a dia'[Fab_Nome_Fabricante], 'Contratos dia a dia'[ID do contrato]), 
			            'Contratos dia a dia'[ID do grupo],
			            "@Count", COUNTROWS ( 'Contratos dia a dia' )
			        ),
			        [@Count]
			            = CALCULATE (
			                COUNTROWS ( 'Contratos dia a dia' ),
			                ALL(Contratos[ID do contrato]),
			                'Contratos dia a dia'[Data de inativação] < TODAY()
			            )
			    )
			)
			```
		displayFolder: _Medidas
		lineageTag: 590c8d04-df26-49d9-a7f5-e1220a8854f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Soluções' =
			
			CALCULATE(
			    DISTINCTCOUNT('Contratos dia a dia'[Fab_Nome_Fabricante]),
			    NOT( ISBLANK('Contratos dia a dia'[Fab_Nome_Fabricante])),
			    FILTER('Contratos dia a dia', [Total Grupo Cliente Ativo] > 0))
		formatString: 0
		displayFolder: _Medidas
		lineageTag: cedc4e08-6765-484d-8704-7f340ac79afa

	measure 'Total Soluções Novas' = ```
			
			VAR _DataFim =
			    CALCULATE ( MIN ( 'dCalendario'[Date] ), ALLSELECTED ( 'Contratos dia a dia' ) )
			VAR __CURRENT_VALUES =
			FILTER ( VALUES ( 'Contratos dia a dia'[Fab_Nome_Fabricante]), NOT ISBLANK ( 'Contratos dia a dia'[Fab_Nome_Fabricante] ) ) 
			VAR __EXISTING_VALUES =
			    FILTER (
			        KEEPFILTERS ( __CURRENT_VALUES ),
			        CALCULATE (
			            [Total Soluções],
			            ALL('Contratos dia a dia'[Nome Grupo]),
			            FILTER (
			                ALL ( 'dCalendario'), 'dCalendario'[Date] < _DataFim
			            )
			        )
			    )
			RETURN
			    CALCULATE (
			        [Total Soluções],
			        EXCEPT ( __CURRENT_VALUES, __EXISTING_VALUES )
			    )
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 5bae66d1-4757-470a-8872-5256d2f41518

	measure 'Total Soluções Inativadas / Perdidas' = ```
			
			CALCULATE (
			    [Total Soluções], 
			    FILTER ('Contratos dia a dia',
			                [Clientes Perdidos] > 0))
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: a47cf630-2ba2-4daf-869d-22db450ca5d1

	measure '% Churn Soluções' = DIVIDE([Total Soluções Inativadas / Perdidas],[Total Soluções])
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: _Medidas
		lineageTag: ea1fa3b4-254c-40bb-893e-b150015ee1ad

	measure 'Qtd. Contratos Ativos' = ```
			
