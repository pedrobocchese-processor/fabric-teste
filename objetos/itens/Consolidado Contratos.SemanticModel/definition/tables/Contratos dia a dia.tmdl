	partition 'Contratos dia a dia-4f3d4aaf-9999-4d70-a011-1d5033e8d229' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("gage.processor.com.br\mssqlsip", "Processor", [Query="SELECT #(lf)       c_dia.[ID do grupo]#(lf)      ,c_dia.[Data]#(lf)      ,c_dia.[ID da empresa Processor]#(lf)      ,c_dia.[ID do contrato]#(lf)      ,c_dia.[Status do contrato]#(lf)      ,c_dia.[Razão do status]#(lf)      ,c_dia.[Valor do pedido]#(lf)      ,c_dia.[Data de inativação] #(lf)      ,c.[ID do fabricante]#(lf)      ,c.[ID do cliente]#(lf)      ,c.[ID do pilar]#(lf)      ,c.Tipo#(lf)      ,c.[Data de inicio] as 'Início da vigência'#(lf)      ,c.[Data de renovação] #(lf)      ,c.[Data de revisão] #(lf)      ,c.[Contrato perdido] #(lf)      ,f.[Fab_Nome_Fabricante]#(lf)      ,'' as 'Nome Grupo'#(lf)  FROM [Processor].[dbo].[BIAnalisePorContrato_V2] c_dia #(lf)       left join sipm.vw_BI_Contratos_v2 c on c_dia.[ID do contrato] = c.[ID do contrato]  #(lf)       left join Fabricantes f on f.[Fab_Codigo_Fabricante] = c.[ID do fabricante]#(lf)#(tab)WHERE c_dia.[ID do contrato] IS NOT NULL AND #(lf)   c.Tipo in ('SERV&SOL','BIZSOL&TECH') and year(c_dia.[Data]) >= 2021", CommandTimeout=#duration(0, 4, 0, 0)]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"ID do pilar", Int64.Type}, {"ID do fabricante", Int64.Type}, {"Início da vigência", type date}, {"Data", type date}, {"Data de renovação", type date}, {"Data de revisão", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegação

