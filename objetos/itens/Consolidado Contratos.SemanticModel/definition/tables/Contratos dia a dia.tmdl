			    DISTINCTCOUNT('Contratos dia a dia'[ID do contrato]),
			    'Contratos dia a dia'[Contrato perdido] IN {"Sim"})
		formatString: #,0
		displayFolder: _Medidas
		lineageTag: c2932299-9213-4bd7-9ae4-6c03fca17dd9

	measure 'Qtd. Contratos Inat. / Perd.' = [Qtd. Contratos Inativos] + [Qtd. Contratos Perdidos]
		formatString: #,0
		isHidden
		displayFolder: _Medidas
		lineageTag: 8ef87258-5438-4e87-a2a6-d583722d7f5d

		changedProperty = IsHidden

	measure 'Grupos Perdidos' = ```
			
			CALCULATE(
			    [Qtd_Clientes_Anter],
			    FILTER(
			        SUMMARIZE(
			            'Contratos dia a dia',
			            'Contratos dia a dia'[ID do grupo],
			            "Total Ativos", [Qtd. Contratos] = [Qtd. Contratos Inativos] 
			        ),
			        [Total Ativos]
			    ))
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: ca50979f-35ae-4b13-ba21-9b22d87cc21c

	measure 'Qtd. Novos Contratos LM' =
			
			CALCULATE([Qtd. Novos Contratos],PREVIOUSMONTH(dCalendario[Date]))
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 97951f91-f237-40cd-ae56-ed7f99aab51b

	measure 'Qtd. Contratos Ativos LM' = ```
			
